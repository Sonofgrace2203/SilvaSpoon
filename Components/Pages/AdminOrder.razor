@page "/Admin/Orders"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities;
@using silvaspoon.Components.Shared
@using silvaspoon.Models
@using silvaspoon.Models.Pagination
@using silvaspoon.Services
@inject IMealApiService MealApiService
@inject IOrderApiService OrderApiService
@inject NavigationManager Nav
@layout AdminLayout

<div class="mgt--10">
    <div class="flex pdt pdb flex-spacebetween mgb-5">
        <div>
            <h3 class="mgb-0">Orders</h3>
        </div>
    </div>

    <div class="flex flex-start flow mgb-15">
        <OrderStat Title="Total Orders" Num="@TotalOrders.ToString()" Tag="@TotalOrdersTag" />
        <OrderStat Title="Pending" Num="@PendingOrders.ToString()" Tag="Needs attention" />
        <OrderStat Title="Preparing" Num="@PreparingOrders.ToString()" Tag="In kitchen" />
        <OrderStat Title="Delivered" Num="@DeliveredOrders.ToString()" Tag="Completed" />
        <OrderStat Title="Today's Revenue" Num="@($"₦{TodayRevenue:N0}")" Tag="Delivered today" />
        <OrderStat Title="Total Revenue" Num="@($"₦{TotalRevenue:N0}")" Tag="All time" />
    </div>

    <div class="mgb-3 flex flex-spacebetween flow">
        <div class="mgb-2">
            <button class="pd bg-primary-01 bd setting-btn mgb" @onclick='() => FilterOrders("all")'>All</button>
            <button class="pd bg-primary-01 bd setting-btn mgb"
                    @onclick='() => FilterOrders("pending")'>Pending</button>
            <button class="pd bg-primary-01 bd setting-btn mgb"
                    @onclick='() => FilterOrders("preparing")'>Preparing</button>
            <button class="pd bg-primary-01 bd setting-btn mgb" @onclick='() => FilterOrders("on delivery")'>On
                Delivery</button>
                <button class="pd bg-primary-01 bd setting-btn mgb"
                        @onclick='() => FilterOrders("delivered")'>Delivered</button>
                <button class="pd bg-primary-01 bd setting-btn mgb"
                        @onclick='() => FilterOrders("cancelled")'>Cancelled</button>
            </div>

            <div class="flex flex-center">
                <input placeholder="Search by Order ID, Customer or Phone..."
                       class="pd-3 bg-primary-01 corner-5 wx-3 bd-none" @bind="searchText" @onkeydown="HandleSearchKeyDown" />

                <button class="pd bg-primary bd-none corner-5 mgr-2" @onclick="SearchOrders">
                    <i class="mdi mdi-magnify"></i>
                </button>
            </div>
        </div>

        <div class="wf">
            <div class="wf hx-5 scroll">
                <table class="wf shadow-border-5">
                    <thead>
                        <tr>
                            <th class="bd pd bg-primary-02">Order Id</th>
                            <th class="bd pd bg-primary-02">Customer</th>
                            <th class="bd pd bg-primary-02">Phone</th>
                            <th class="bd pd bg-primary-02">Items</th>
                            <th class="bd pd bg-primary-02">Order Time</th>
                            <th class="bd pd bg-primary-02">Status</th>
                            <th class="bd pd bg-primary-02">Total</th>
                            <th class="bd pd bg-primary-02">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td class="bd pd bg-white text-center">#ORD-@order.Id</td>
                                <td class="bd pd bg-white">@order.CustomerName</td>
                                <td class="bd pd bg-white">@order.PhoneNumber</td>
                                <td class="bd pd bold bg-white">@order.OrderItems.Count Item(s)</td>
                                <td class="bd pd bg-white">@order.OrderedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="bd pd bg-white">
                                    <div class="flex flex-center">
                                        <Badge BadgeTitle="@order.Status" BgColor="@GetStatusColor(order.Status)"
                                               ClColor="@GetStatusTextColor(order.Status)" />
                                    </div>
                                </td>
                                <td class="bd pd bold cl-secondary bg-white text-center">₦@order.TotalAmount.ToString("N0")</td>
                                <td class="bd pd bg-white">
                                    <div class="flex flex-center">
                                        <i class="mdi mdi-eye fsz-20 mgr-5 pointer cl-primary"
                                           @onclick="() => ShowOrderDetails(order.Id)"></i>
                                        <i class="mdi mdi-delete cl-fatal fsz-20 pointer"
                                           @onclick="() => ConfirmDeleteOrder(order.Id)"></i>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (orderPage != null && orderPage.TotalItems > 0)
        {
            <Pagination CurrentPage="@currentPage" PageSize="@pageSize" PageTotal="@orderPage.TotalItems"
                        TotalPages="@orderPage.TotalPages" PreviousPage="PreviousPage" NextPage="NextPage" GoToPage="GoToPage" />
        }
    </div>

    <div style="display: @(showOrderDetails ? "block" : "none");">
        <AdminOrderDetails OrderId="@selectedOrderId" OnClick="CancelOrderDetails" OnStatusChanged="ReloadOrders" />
    </div>

    @if (confirmOrderDelete)
    {
        <ConfirmDialog Text="Are you sure you want to delete this order?" ConfirmBtn="Delete" CancelBtn="Cancel"
                       Confirm="DeleteOrder" Cancel="CancelDeleteOrder" />
    }

@code {
    private bool confirmOrderDelete = false;
    private int orderToDeleteId;
    private bool showOrderDetails = false;
    private int selectedOrderId;
    private string searchOrders = "";
    private string currentFilter = "all";
    private PagedResult<Order>? orderPage;
    private int currentPage = 1;
    private int pageSize = 10;

    private OrderStatsDto orderStats = new();

    private int TotalOrders => orderStats.TotalOrders;
    private int TodayOrders => orderStats.TodayOrders;
    private int PendingOrders => orderStats.PendingOrders;
    private int PreparingOrders => orderStats.PreparingOrders;
    private int DeliveredOrders => orderStats.DeliveredOrders;
    private decimal TodayRevenue => orderStats.TodayRevenue;
    private decimal TotalRevenue => orderStats.TotalRevenue;

    private List<Order> orders = new();
    private DateTime Today => DateTime.Today;

    private string TotalOrdersTag => $"+{TodayOrders} today";

    private string searchText = "";

    private async Task SearchOrders()
    {
        currentPage = 1;
        await LoadOrders();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchOrders();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        if (QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("status", out var status))
        {
            currentFilter = status.ToString().ToLower();
        }

        await LoadOrders();
        await LoadOrderStats();
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadOrders();
        }
    }

    private async Task FilterOrders(string status)
    {
        currentFilter = status;
        currentPage = 1;

        await LoadOrders();

        if (status == "all")
            Nav.NavigateTo("Admin/Orders", false);
        else
            Nav.NavigateTo($"Admin/Orders?status={status}", false);
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Pending" => "rgba(255,193,7,.2)",
            "Preparing" => "rgba(13,110,253,.2)",
            "Delivered" => "rgba(25,135,84,.2)",
            "Cancelled" => "rgba(220,53,69,.2)",
            _ => "rgba(108,117,125,.2)"
        };
    }

    private string GetStatusTextColor(string status)
    {
        return status switch
        {
            "Pending" => "#FFC107",
            "Preparing" => "#0D6EFD",
            "Delivered" => "#198754",
            "Cancelled" => "#DC3545",
            _ => "#6C757D"
        };
    }

    private void ShowOrderDetails(int id)
    {
        selectedOrderId = id;
        showOrderDetails = true;
    }

    private void ConfirmDeleteOrder(int id)
    {
        orderToDeleteId = id;
        confirmOrderDelete = true;
    }

    private void CancelDeleteOrder()
    {
        confirmOrderDelete = false;
    }

    private async Task DeleteOrder()
    {
        confirmOrderDelete = false;

        await OrderApiService.DeleteOrderAsync(orderToDeleteId);

        await LoadOrders();
        await LoadOrderStats();
    }

    private void CancelOrderDetails()
    {
        showOrderDetails = false;
    }

    private async Task ReloadOrders()
    {
        await LoadOrders();
        await LoadOrderStats();
    }

    private async Task LoadOrders()
    {
        var status = currentFilter == "all"
            ? null
            : currentFilter;

        orderPage = await OrderApiService.GetOrdersAsync(
            currentPage,
            pageSize,
            searchText,
            status);

        orders = orderPage.Items;
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            await LoadOrders();
        }
    }

    private async Task NextPage()
    {
        if (orderPage != null && currentPage < orderPage.TotalPages)
        {
            currentPage++;

            await LoadOrders();
        }
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;

        await LoadOrders();
    }

    private async Task LoadOrderStats()
    {
        orderStats = await OrderApiService.GetOrderStatsAsync();
    }
}