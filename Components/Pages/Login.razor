@if (!string.IsNullOrWhiteSpace(LoginError))
{
    <p class="fsz-13">@LoginError</p>
}

@code {
    private LoginModel loginModel = new();

    private string LoginError { get; set; } = string.Empty;

    private bool IsLoading { get; set; }

    private bool ShowPassword { get; set; }

    private async Task HandleLogin()
    {
        LoginError = string.Empty;
        IsLoading = true;

        try
        {
            var result = await AuthApiService.LoginAsync(
                new silvaspoon.Models.Auth.LoginRequest
                {
                    Username = loginModel.Username,
                    Password = loginModel.Password
                });

            if (result is null)
            {
                LoginError = "Invalid username or password.";
                return;
            }

            if (CustomerAuthenticationStateProvider
                is CustomAuthenticationStateProvider authStateProvider)
            {
                authStateProvider.NotifyUserAuthentication(result.Token);
            }

            Nav.NavigateTo("/Dashboard");
        }
        catch
        {
            LoginError = "Unable to sign in. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }
}