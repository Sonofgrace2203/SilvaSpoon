@page "/Dashboard"
@attribute [Authorize(Roles = "Admin")]
@using silvaspoon.Components.Shared
@using silvaspoon.Models
@using silvaspoon.Services

@inject IMealApiService MealApiService
@inject IOrderApiService OrderApiService
@inject IImageUrlService ImageUrlService
@inject NavigationManager Nav
@layout AdminLayout


<div class="mgt--10">
    <div class="flex pd flex-spacebetween">
        <h3>Dashboard</h3>
    </div>

    <div class="bd pd shadow-border-3 bg-secondary-01 mgb-2">
        <h4 class="pd bg-secondary-02">Meals Statistics</h4>
        <div class="flex flex-start flow mgb-5">
            <StatCard Img="icons/tmeals.svg" Text1="Total Meals" NumCount="@stats.TotalMeals.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Meals?filter=all"))" />
            <StatCard Img="icons/cooking.svg" Text1="Available Meals" NumCount="@stats.AvailableMeals.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Meals?filter=available"))" />
            <StatCard Img="icons/stock.svg" Text1="Out of Stock" NumCount="@stats.UnavailableMeals.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Meals?filter=unavailable"))" />
            <StatCard Img="icons/orders.svg" Text1="Total Orders" NumCount="@stats.TotalOrders.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Orders?status=all"))" />
            <StatCard Img="icons/customer.svg" Text1="Customers" NumCount="@stats.TotalCustomers.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Orders"))" />
        </div>
    </div>

    <div class="bd pd shadow-border-3 bg-secondary-01 mgb-2">
        <h4 class="pd bg-secondary-02">Orders Statistics</h4>
        <div class="flex flex-start flow mgb-10">
            <StatCard Img="icons/orders.svg" Text1="Pending" NumCount="@stats.PendingOrders.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Orders?status=pending"))" />
            <StatCard Img="icons/cooking.svg" Text1="Preparing" NumCount="@stats.PreparingOrders.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Orders?status=preparing"))" />
            <StatCard Img="icons/check.svg" Text1="Delivered" NumCount="@stats.DeliveredOrders.ToString()"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Orders?status=delivered"))" />
            <StatCard Img="icons/revenue.svg" Text1="Pending Value" NumCount="@($"₦{stats.PendingValue:N0}")"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Orders?status=pending"))" />
            <StatCard Img="icons/revenue.svg" Text1="Total Revenue" NumCount="@($"₦{stats.Revenue:N0}")"
                      OnClick="@(() => Nav.NavigateTo("/Admin/Orders?status=delivered"))" />
        </div>
    </div>

    <div class="bd pd shadow-border-3 bg-secondary-01 mgb-2">
        <h4 class="pd bg-secondary-03">Top Meals & Customer's Stats</h4>
        <div class="row responsive col-3">
            <div class="pd corner-3 bd bg-card shadow-border-2 miwx-25 mgr-2 mgb-2">
                <h3 class="pd">Top Meals</h3>
                <table class="wf pd shadow-border-5">
                    <tbody>
                        @foreach (var meal in TopMeals)
                        {
                            <tr>
                                <td class="bdt pd">
                                    <img src="@(ImageUrlService.GetImageUrl(meal.Image) ?? "icons/meal-placeholder.png")"
                                         class="wx-05 hx-05 corner-1" />
                                </td>
                                <td class="fw-bold bdt pd">@meal.MealName</td>
                                <td class="cl-secondary bdt pd">@meal.TotalOrders Orders</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pd corner-3 bd bg-card shadow-border-2 miwx-25 mgr-2 mgb-2">
                <div class="flex flex-spacebetween flex-center">
                    <h3 class="pd">Recent Orders</h3>
                    <button class="pd bg-secondary bd-none corner-2 button"
                            @onclick="@(() => Nav.NavigateTo("/Admin/Orders"))">View all</button>
                </div>
                <div class="corner-3 bd shadow-border-2 scroll">
                    <table class="wf pd shadow-border-5">
                        <tbody class="wf">
                            @foreach (var order in RecentOrders)
                            {
                                <tr class="wf">
                                    <td class="fw-bold bdt pd">@order.CustomerName</td>
                                    <td class="bdt pd">@order.PhoneNumber</td>
                                    <td class="bdt pd">@order.OrderItems.Sum(i => i.Quantity) Meals</td>
                                    <td class="bdt pd">@order.OrderedAt.ToString("hh:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Meal> meals = new();
    private List<Order> orders = new();

    private DashboardStats stats = new();

    private List<Order> RecentOrders = new();
    private List<MealSales> TopMeals = new();

    protected override async Task OnInitializedAsync()
    {
        orders = await OrderApiService.GetOrdersAsync();

        stats = await MealApiService.GetDashboardStatsAsync();

        LoadDashboard();
    }

    private void LoadDashboard()
    {
        // Recent Orders
        RecentOrders = orders.OrderByDescending(x => x.OrderedAt).Take(5).ToList();

        // Top Meals
        TopMeals = orders.SelectMany(o => o.OrderItems).GroupBy(i => i.Meal!.Name)
            .Select(g => new MealSales
            {
                MealName = g.Key!,
                TotalOrders = g.Sum(x => x.Quantity),
                Image = g.First().Meal!.ImageUrl
            })
            .OrderByDescending(x => x.TotalOrders)
            .Take(5)
            .ToList();
    }
}