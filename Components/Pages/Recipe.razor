<Footer />

@code {
    [Parameter] public int RecipeId { get; set; }
    private List<MealCategory> categories = new();

    private RecipeModel? recipe;

    private List<RecipeModel> recipes = new();

    protected override async Task OnInitializedAsync()
    {
        recipes = await RecipeApiService.GetRecipesAsync();

        categories = await MealCategoryService.GetAsync()
                 ?? new List<MealCategory>();

        await LoadRecipes();
    }

    private IEnumerable<RecipeModel> filteredRecipes =>
   recipes
       .Where(x => x.IsPublished)
       .OrderBy(x => Guid.NewGuid())
       .Take(6);

    private async Task FilterByCategory(string category)
    {
        @* currentFilter = category;
        currentPage = 1; *@

        await LoadRecipes();
    }

    private async Task LoadRecipes()
    {
        recipes = await RecipeApiService.GetRecipesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RecipeId == 0)
            return;

        recipe = await RecipeApiService.GetRecipeAsync(RecipeId);
    }

    private void GoToCategory(string category)
    {
        Nav.NavigateTo($"Recipe/Client?category={Uri.EscapeDataString(category)}");
    }
}