@inject IMealApiService MealApiService
@inject NavigationManager Nav
@inject IImageUrlService ImageUrlService

<div class="wvg-5">
    <div class="flex flex-center stack">
        <div class="flex">
            <h3 class="mgr-3 mgt-0 mgb-0 fsz-30">Featured</h3>
            <h3 class="cl-secondary mg-0 fsz-30">Meals</h3>
        </div>
        <p class="fsz-15 op-6 mgt-1">A taste of what we offer</p>
    </div>
    <div class="flex flex-start">
        <div class="pd-5 flex scroll flex-start">
            @if (isLoading)
            {
                <LoadingIndicator Message="Loading Meals..." Class="meals-loading" />
            }
            else
            {
                <div class="flex">
                    @foreach (var meal in filteredMeals)
                    {
                        @if (meal.IsAvailable)
                        {
                            <MealCard Img="@(ImageUrlService.GetImageUrl(meal.ImageUrl) ?? "icons/customer.jpeg")"
                                      MealTitle="@meal.Name" MealPrice="@($"₦{meal.Price:N0}")" MealDesc="@meal.Description"
                                      AltTitle="@meal.Name" />
                        }
                    }
                </div>
            }
        </div>
    </div>
    <div class="flex flex-center">
        <button class="text-center corner-6 bg-primary pdl-20 pdr-20 pdt-3 pdb-3 bd-none button"
                @onclick="GoToMenu">View Full Menu</button>
    </div>
</div>



<div class="wvl-5">
    <div class="flex flex-center stack">
        <div class="flex">
            <h3 class="mgr-3 mgt-0 mgb-0 fsz-25">Featured</h3>
            <h3 class="cl-secondary mg-0 fsz-25">Meals</h3>
        </div>
        <p class="fsz-15 op-6 mgt-1">A taste of what we offer</p>
    </div>
    <div class="flex scroll">
        <div class="flex">
            @if (isLoading)
            {
                <LoadingIndicator Message="Loading Meals..." Class="meals-loading" />
            }
            else
            {
                <div class="flex">
                    @foreach (var meal in filteredMeals)
                    {
                        @if (meal.IsAvailable)
                        {
                            <MealCard Img="@(ImageUrlService.GetImageUrl(meal.ImageUrl) ?? "icons/customer.jpeg")"
                                      MealTitle="@meal.Name" MealPrice="@($"₦{meal.Price:N0}")" MealDesc="@meal.Description"
                                      AltTitle="@meal.Name" />
                        }
                    }
                </div>
            }
        </div>
    </div>
    <div class="flex flex-center">
        <button class="text-center corner-6 bg-primary pdl-20 pdr-20 pdt-3 pdb-3 bd-none button"
                @onclick="GoToMenu">View Full Menu</button>
    </div>
</div>

@code {
    private List<Meal> meals = new();
    private bool isLoading = true;

    private void GoToMenu()
    {
        Nav.NavigateTo("Menu");
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            meals = await MealApiService.GetMealsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<Meal> filteredMeals => meals.OrderBy(x => Guid.NewGuid()).Take(6);
}