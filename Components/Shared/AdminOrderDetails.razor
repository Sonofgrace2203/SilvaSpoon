@code
{
    [Parameter] public int OrderId { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    private Order? order;

    private DeliverySetting? deliverySetting;

    private string selectedStatus = "";

    private decimal Subtotal => order?.OrderItems?.Sum(x => x.UnitPrice * x.Quantity) ?? 0;

    private decimal Total => Subtotal + DeliveryFee;

    private decimal DeliveryFee
    {
        get
        {
            if (deliverySetting == null)
                return 0;

            if (deliverySetting.FreeDeliveryAbove > 0 &&
                Subtotal >= deliverySetting.FreeDeliveryAbove)
            {
                return 0;
            }

            return deliverySetting.DeliveryFee;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OrderId == 0)
            return;

        order = await MealApiService.GetOrderAsync(OrderId);

        if (order != null)
            selectedStatus = order.Status;
    }

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += Refresh;

        deliverySetting =
            await DeliverySettingsApiService.GetAsync()
            ?? new DeliverySetting();
    }

    private async Task HandleClick()
    {
        await OnClick.InvokeAsync();
    }

    private async Task SaveStatus()
    {
        if (order == null)
            return;

        await MealApiService.UpdateOrderStatusAsync(
            order.Id,
            selectedStatus);

        order.Status = selectedStatus;

        await OnStatusChanged.InvokeAsync();

        await OnClick.InvokeAsync();
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Pending" => "rgba(255,193,7,.2)",
            "Preparing" => "rgba(13,110,253,.2)",
            "Delivered" => "rgba(25,135,84,.2)",
            "Cancelled" => "rgba(220,53,69,.2)",
            _ => "rgba(108,117,125,.2)"
        };
    }

    private string GetStatusTextColor(string status)
    {
        return status switch
        {
            "Pending" => "#FFC107",
            "Preparing" => "#0D6EFD",
            "Delivered" => "#198754",
            "Cancelled" => "#DC3545",
            _ => "#6C757D"
        };
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.OnChange -= Refresh;
    }
}