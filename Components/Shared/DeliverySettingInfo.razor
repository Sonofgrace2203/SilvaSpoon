    public async Task SaveSettings()
    {
        // Update general delivery settings
        savedSetting.DeliveryFee = editingSetting.DeliveryFee;
        savedSetting.FreeDeliveryAbove = editingSetting.FreeDeliveryAbove;
        savedSetting.EstimatedDeliveryTime = editingSetting.EstimatedDeliveryTime;

        // Add only the newly entered areas
        foreach (var area in editingSetting.Areas)
        {
            if (!savedSetting.Areas.Any(a =>
                a.Name.Equals(area.Name, StringComparison.OrdinalIgnoreCase)))
            {
                savedSetting.Areas.Add(new DeliveryArea
                {
                    Name = area.Name,
                    Fee = area.Fee
                });
            }
        }

        // Save everything
        savedSetting = await DeliveryService.UpdateAsync(savedSetting)
                        ?? savedSetting;

        // Reset the form
        editingSetting.Areas = new List<DeliveryArea>();

        editingSetting.DeliveryFee = savedSetting.DeliveryFee;
        editingSetting.FreeDeliveryAbove = savedSetting.FreeDeliveryAbove;
        editingSetting.EstimatedDeliveryTime = savedSetting.EstimatedDeliveryTime;

        newArea = "";

        StateHasChanged();
    }

    
    private void ConfirmDeleteSavedArea(DeliveryArea area)
    {
        areaToDelete = area;
        confirmAreaDelete = true;
    }

    private void CancelDeleteSavedArea()
    {
        areaToDelete = null;
        confirmAreaDelete = false;
    }

    private async Task DeleteSavedArea()
    {
        if (areaToDelete == null)
            return;

        savedSetting.Areas.Remove(areaToDelete);

        savedSetting = await DeliveryService.UpdateAsync(savedSetting)
                        ?? savedSetting;

        editingSetting = Clone(savedSetting);

        areaToDelete = null;
        confirmAreaDelete = false;

        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddArea();
        }
    }
}