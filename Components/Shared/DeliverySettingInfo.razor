                    Name = area.Name,
                    Fee = area.Fee
                });
            }
        }

        // Save the merged result
        savedSetting = await DeliveryService.UpdateAsync(savedSetting)
                        ?? savedSetting;

        // Clear only the form list
        editingSetting.Areas.Clear();

        editingSetting.DeliveryFee = savedSetting.DeliveryFee;
        editingSetting.FreeDeliveryAbove = savedSetting.FreeDeliveryAbove;
        editingSetting.EstimatedDeliveryTime = savedSetting.EstimatedDeliveryTime;

