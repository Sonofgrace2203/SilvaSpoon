@using silvaspoon.Models

@inject IImageUrlService ImageUrlService

<div class="bd pd-5 corner-3 mgr-5 mgb-5 wvg-5 shadow-border-3 mihx-15">
    <div class="flex">
        <div class="flex flex-center">
            <img src="@(ImageUrlService.GetImageUrl(Review.ImageUrl) ?? "icons/customer.jpeg")"
                     alt="@Review.CustomerName" class="mgr-5 round wx-05 hx-05 bd pd-1" />
            <div>
                <h4 class="mg-0 pdb-2">@Review.CustomerName</h4>
                <div>
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Review.Rating)
                        {
                            <i class="mdi mdi-star cl-secondary"></i>
                        }
                        else
                        {
                            <i class="mdi mdi-star-outline"></i>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <p class=" wx-3">@Review.Comment</p>
</div>

<div class="bd pd-5 corner-3 mgr-5 mgb-5 wvl-5 shadow-border-3 mihx-15">
    <div class="flex wx-3">
        <div class="flex flex-center">
            <img src="@(ImageUrlService.GetImageUrl(Review.ImageUrl) ?? "icons/customer.jpeg")"
                     alt="@Review.CustomerName" class="mgr-5 round wx-05 hx-05 bd pd-1" />
            <div>
                <h4 class="mg-0 pdb-2">@Review.CustomerName</h4>
                <div>
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Review.Rating)
                        {
                            <i class="mdi mdi-star cl-secondary"></i>
                        }
                        else
                        {
                            <i class="mdi mdi-star-outline"></i>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <p class="">@Review.Comment</p>
</div>

@code {
    [Parameter] public Review Review { get; set; } = new();
}