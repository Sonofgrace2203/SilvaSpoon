@using silvaspoon.Components.Pages
@using silvaspoon.Models.Settings
@using silvaspoon.Services.Settings
@using silvaspoon.Services
@implements IDisposable
@inject CartService CartService
@inject IImageUrlService ImageUrlService
@inject BusinessSettingsState BusinessSettingsState

@inject IBusinessSettingsApiService BusinessSetting
@inject ISocialMediaSettingsApiService SocialMedia
@inject IContactSettingsApiService ContactSetting



<div class="bg-primary wvg-5 pd-5">
    <div class="flex flex-spacebetween flex-center pd pos-rel">
        <div>
            @if (isLoading)
            {
                <div class="flex flex-center">
                    <LoadingIndicator Class="meals-loading" />
                </div>
            }
            else
            {
                <div class="flex fsz-40">
                    <p class="cl-secondary fw-bold fsz-30 mg-0">@businessInfoSetting.BusinessName.ToUpper()</p>
                </div>
            }
            <p>&copy 2026... All Right Reserved.</p>

            <div class="mgt-5">
                <NavLink href="Login" class="cl-white op-7 fsz-12" style="text-decoration: none;">
                    Admin
                </NavLink>
            </div>
        </div>

        <div class="mgr-30">
            <p>Follow Us</p>
            <div class="mgt--2">
                <NavLink class="mgr-2 cl-white op-7" style="text-decoration: none;"
                         href="@socialMediaSetting.Instagram">
                    <i class="mdi mdi-instagram"></i>
                </NavLink>
                <NavLink class="mgr-2 cl-white op-7" style="text-decoration: none;" href="@socialMediaSetting.Facebook">
                    <i class="mdi mdi-facebook"></i>
                </NavLink>
                <NavLink class="mgr-2 cl-white op-7" style="text-decoration: none;" href="@socialMediaSetting.Twitter">
                    <i class="mdi mdi-twitter"></i>
                </NavLink>
                <NavLink class="mgr-2 cl-white op-7" style="text-decoration: none;" href="@socialMediaSetting.Website">
                    <i class="mdi mdi-web"></i>
                </NavLink>
            </div>
        </div>

        <div style="position: absolute; top: -40px; right: 30px;">
            <NavLink class="mgr-2 cl-white" style="text-decoration: none;"
                     href="@($"https://wa.me/{contactInfoSetting.PhoneNumber}")">
                <WhatsApp />
            </NavLink>
        </div>
    </div>
</div>

<div class="bg-primary wvl-5">
    <div class="flex flex-spacebetween flex-center pd pdt-10 pos-rel">
        <div>
            @if (isLoading)
            {
                <div class="flex flex-center">
                    <LoadingIndicator Class="meals-loading" />
                </div>
            }
            else
            {
                <div class="flex">
                    <p class="cl-secondary fw-bold fsz-20 mg-0">@businessInfoSetting.BusinessName</p>
                </div>
            }
            <p class="fsz-13">&copy 2026... All Right Reserved.</p>

            <div class="mgt-5">
                <NavLink href="Login" class="cl-white op-7 fsz-12" style="text-decoration: none;">
                    Admin
                </NavLink>
            </div>
        </div>

        <div class="mgr-15">
            <p>Follow Us</p>
            <div class="mgt--5">
                <NavLink class="mgr-2 cl-white op-7" style="text-decoration: none;"
                         href="@socialMediaSetting.Instagram">
                    <i class="mdi mdi-instagram"></i>
                </NavLink>
                <NavLink class="mgr-2 cl-white op-7" style="text-decoration: none;" href="@socialMediaSetting.Facebook">
                    <i class="mdi mdi-facebook"></i>
                </NavLink>
                <NavLink class="mgr-2 cl-white op-7" style="text-decoration: none;" href="@socialMediaSetting.Twitter">
                    <i class="mdi mdi-twitter"></i>
                </NavLink>
                <NavLink class="mgr-2 cl-white op-" style="text-decoration: none;" href="@socialMediaSetting.Website">
                    <i class="mdi mdi-web"></i>
                </NavLink>
            </div>
        </div>

        <div style="position: absolute; top: -20px; right: 30px;">
            <NavLink class="mgr-2 cl-white" style="text-decoration: none;"
                     href="@($"https://wa.me/{contactInfoSetting.PhoneNumber}")">
                <WhatsApp />
            </NavLink>
        </div>
    </div>
</div>

@code {
    private BusinessSetting businessInfoSetting = new();
    private SocialMediaSetting socialMediaSetting = new();
    private ContactSetting contactInfoSetting = new();

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            businessInfoSetting = await BusinessSetting.GetAsync() ?? new BusinessSetting();
            socialMediaSetting = await SocialMedia.GetAsync() ?? new SocialMediaSetting();
            contactInfoSetting = await ContactSetting.GetAsync() ?? new ContactSetting();
        }
        finally
        {
            isLoading = false;
        }

        BusinessSettingsState.Set(businessInfoSetting);
        BusinessSettingsState.OnChange += Refresh;
    }

    private void Refresh()
    {
        businessInfoSetting = BusinessSettingsState.Current;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BusinessSettingsState.OnChange -= Refresh;
    }
}