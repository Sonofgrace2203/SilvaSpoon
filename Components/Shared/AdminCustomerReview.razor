@using silvaspoon.Models
@using silvaspoon.Services
@inject NavigationManager Nav
@inject IImageUrlService ImageUrlService

<div class="bd pd-5 corner-3 mgr-2 mgb-2 wvg-5 shadow-border-5 bg-card wx-45 mihx-17 cardani">
    <div class="flex">
        <div class="flex flex-center">
            <div class="flex flex-center mgr-15">
                <img src="@(ImageUrlService.GetImageUrl(Review.ImageUrl) ?? "icons/customer.jpeg")"
                     alt="@Review.CustomerName" class="mgr-5 round wx-05 hx-05 bd pd-1" />
                <div>
                    <h4 class="mg-0 pdb-2">@Review.CustomerName</h4>
                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Review.Rating)
                            {
                                <i class="mdi mdi-star fsz-20 cl-secondary"></i>
                            }
                            else
                            {
                                <i class="mdi mdi-star-outline fsz-20 op-4"></i>
                            }
                        }
                    </div>
                    <p class="">@Review.Comment</p>
                </div>
            </div>
            <div>
                @if (Review.IsPublished)
                {
                    <Badge BadgeTitle="Published" BgColor="rgba(25,135,84,.2)" ClColor="#198754" />
                }
                else
                {
                    <Badge BadgeTitle="Draft" BgColor="rgba(255,193,7,.2)" ClColor="#FFC107" />
                }
                <p class="text-center">@Review.CreatedAt.ToString("dd MMM yyyy")</p>
                <div class="text-center">
                    <button class="mdi mdi-pencil bg-primary-01 cl-primary fsz-20 pd bd mgr-3"
                            @onclick='() => Nav.NavigateTo($"/Admin/Reviews/Edit/{Review.Id}")'>
                    </button>
                    <button class="mdi mdi-delete bg-secondary-01 cl-secondary fsz-20 pd bd"
                            @onclick="() => OnDelete.InvokeAsync(Review.Id)"></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bd pd-5 corner-3 mgb-5 wvl-5 shadow-border-5 bg-card cardani">
    <div class="">
        <div class="">
            <div class="flex">
                <img src="@(ImageUrlService.GetImageUrl(Review.ImageUrl) ?? "icons/customer.jpeg")"
                     alt="@Review.CustomerName" class="mgr-5 round wx-05 hx-05 bd pd-1" />
                <div>
                    <h4 class="mg-0 pdb-2">@Review.CustomerName</h4>
                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Review.Rating)
                            {
                                <i class="mdi mdi-star fsz-20 cl-secondary"></i>
                            }
                            else
                            {
                                <i class="mdi mdi-star-outline fsz-20 op-4"></i>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="flex flex-center mgr-5">
                <div>

                    <p class="">@Review.Comment</p>
                </div>
            </div>
            <div class="">

                <div class="flex flex-spacebetween">
                    <div class="mgt--5">
                        @if (Review.IsPublished)
                        {
                            <Badge BadgeTitle="Published" BgColor="rgba(25,135,84,.2)" ClColor="#198754" />
                        }
                        else
                        {
                            <Badge BadgeTitle="Draft" BgColor="rgba(255,193,7,.2)" ClColor="#FFC107" />
                        }
                        <p class="text-center mg-0">@Review.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="text-center">
                        <button class="mdi mdi-pencil bg-primary-01 cl-primary fsz-20 pd bd mgr-3"
                                @onclick="() => OnEdit.InvokeAsync(Review.Id)"></button>
                        <button class="mdi mdi-delete bg-secondary-01 cl-secondary fsz-20 pd bd"
                                @onclick="() => OnDelete.InvokeAsync(Review.Id)"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Review Review { get; set; } = new();
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnTogglePublish { get; set; }
}