@using silvaspoon.Models.Settings
@using silvaspoon.Services.Settings
@using Microsoft.AspNetCore.Components.Forms

@inject IMealSettingsApiService MealCategoryService
@inject IImageUrlService ImageUrlService
@inject IUploadApiService UploadApiService

<div>
    <div class="flex mgb-10">
        <h4 class="mg-0 pdt-1">Delivery Settings</h4>
    </div>

    <div class="">
        <div class="mgr-20">
            <div class="flex mgb-3">
                <i class="mdi mdi-marker fsz-15 corner-3 mgr-5"></i>
                <h4 class="mg-0">Meal Categories:</h4>
            </div>
        </div>

        <div>
            <div class="flex flex-start flow">
                @foreach (var category in savedCategories)
                {
                    <div class="flex mgr-5">
                        <div class="mgr-2 mgb-2 flex flex-center pd bd corner-2 bg-card shadow-border-5">

                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img src="@ImageUrlService.GetImageUrl(category.ImageUrl)" class="wx-05 hx-05 corner-1 mgr-2" />
                            }

                            <Badge BadgeTitle="@category.Name" BgColor="rgb(4,99,7,0.3)" ClColor="rgb(4,99,7)" />

                            <div class=" mgl-2">
                                <i class="mdi mdi-delete fsz-15 mg-0 cl-warning" style="cursor:pointer"
                                   @onclick="() => ConfirmDeleteSavedCategory(category)">
                                </i>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mgt-10">
        <div class="stack mgb-10 mgr-5">

            <label class="mgb-1 fsz-15">Meal Category</label>

            <div>
                <InputText class="corner-2 bd pd" placeholder="Enter category..." @bind-Value="newCategory"
                           @onkeydown="HandleKeyDown" />

                <InputFile @key="categoryFileInputKey" OnChange="HandleCategoryImageSelected" />

                <button type="button" class="bg-primary bd-none pd" @onclick="AddCategory">
                    Add Category
                </button>
            </div>

            <div class="flex flex-start flow">
                @foreach (var category in pendingCategories)
                {
                    <div class="flex mgr-5 mgt-3">
                        <div class="mgr-2 mgb-2 flex flex-center pd bd corner-2 bg-card shadow-border-5">

                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img src="@ImageUrlService.GetImageUrl(category.ImageUrl)" class="wx-05 hx-05 corner-1 mgr-2" />
                            }

                            <Badge BadgeTitle="@category.Name" BgColor="rgb(4,99,7,0.3)" ClColor="rgb(4,99,7)" />

                            <div class=" mgl-3">
                                <i class="fsz-15 mg-0 cl-warning" style="cursor:pointer"
                                   @onclick="() => RemovePendingCategory(category)">
                                    &times;
                                </i>
                            </div>

                        </div>
                    </div>
                }
            </div>

        </div>
    </div>

    <div class="">
        <button class="pd corner-2 bd-none bg-primary wf button fsz-16" @onclick="HandleSaveChanges">Save
            Changes</button>
        </div>
    </div>

    @if (confirmCategoryDelete)
    {
        <ConfirmDialog Text="Are you sure you want to delete this meal category?" ConfirmBtn="Delete" CancelBtn="Cancel"
                       Confirm="DeleteSavedCategory" Cancel="CancelDeleteCategory" />
    }

@code {
    [Parameter] public EventCallback SaveChanges { get; set; }

    private List<MealCategory> savedCategories = new();
    private List<MealCategory> pendingCategories = new();

    private bool confirmCategoryDelete = false;
    private MealCategory? categoryToDelete;

    private IBrowserFile? selectedCategoryImage;

    private string newCategory = "";
    private int categoryFileInputKey = 0;

    protected override async Task OnInitializedAsync()
    {
        savedCategories = await MealCategoryService.GetAsync()
                         ?? new List<MealCategory>();

        pendingCategories.Clear();
    }

    private async Task AddCategory()
    {
        if (string.IsNullOrWhiteSpace(newCategory))
            return;

        newCategory = newCategory.Trim();

        bool exists =
            savedCategories.Any(c =>
                c.Name.Equals(
                    newCategory,
                    StringComparison.OrdinalIgnoreCase))
            ||
            pendingCategories.Any(c =>
                c.Name.Equals(
                    newCategory,
                    StringComparison.OrdinalIgnoreCase));

        if (exists)
            return;

        string? imageUrl = null;

        if (selectedCategoryImage != null)
        {
            imageUrl = await UploadApiService.UploadImageAsync(
                selectedCategoryImage,
                "categories");

            Console.WriteLine($"UPLOADED IMAGE URL: {imageUrl}");
        }

        pendingCategories.Add(new MealCategory
        {
            Name = newCategory,
            ImageUrl = imageUrl
        });

        newCategory = "";
        selectedCategoryImage = null;
        categoryFileInputKey++;
    }

    private void RemovePendingCategory(MealCategory category)
    {
        pendingCategories.Remove(category);
    }

    private void ConfirmDeleteSavedCategory(MealCategory category)
    {
        categoryToDelete = category;
        confirmCategoryDelete = true;
    }

    private void CancelDeleteCategory()
    {
        categoryToDelete = null;
        confirmCategoryDelete = false;
    }

    private async Task DeleteSavedCategory()
    {
        if (categoryToDelete == null)
            return;

        savedCategories.Remove(categoryToDelete);

        savedCategories = await MealCategoryService.UpdateAsync(savedCategories)
                          ?? savedCategories;

        categoryToDelete = null;
        confirmCategoryDelete = false;

        StateHasChanged();
    }

    private async Task HandleSaveChanges()
    {
        await SaveChanges.InvokeAsync();
    }

    public async Task SaveSettings()
    {
        // Add pending categories to the saved list
        foreach (var category in pendingCategories)
        {
            if (!savedCategories.Any(c =>
                c.Name.Equals(category.Name, StringComparison.OrdinalIgnoreCase)))
            {
                savedCategories.Add(new MealCategory
                {
                    Name = category.Name,
                    ImageUrl = category.ImageUrl,
                    IsActive = category.IsActive
                });
            }
        }

        // Save the complete category list
        savedCategories = await MealCategoryService.UpdateAsync(savedCategories)
                          ?? savedCategories;

        // Clear only the temporary form list
        pendingCategories.Clear();

        newCategory = "";

        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddCategory();
        }
    }

    private void HandleCategoryImageSelected(
    InputFileChangeEventArgs e)
    {
        selectedCategoryImage = e.File;
    }
}