@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Components.Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView 
                RouteData="@routeData" 
                DefaultLayout="@typeof(MainLayout)"
                @key="refreshKey" />

            <FocusOnNavigate 
                RouteData="@routeData" 
                Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {

    private Guid refreshKey = Guid.NewGuid();

    private DotNetObjectReference<App>? dotNetReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        dotNetReference = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "silvaSpoonSetRefreshReference",
            dotNetReference);
    }

    [JSInvokable]
    public Task RefreshCurrentPage()
    {
        refreshKey = Guid.NewGuid();

        InvokeAsync(StateHasChanged);

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        dotNetReference?.Dispose();
    }
}